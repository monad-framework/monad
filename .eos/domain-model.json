    "WC":{"name":"Work Cycle","entity_type":"WC","id_prefix":"WC","canonical_schema":".eos/schemas/core/wc.schema.json","lifecycle_states":["DRAFT","READY","AUTHORIZED","ACTIVE","IN_REVIEW","CLOSED","BLOCKED"],"registry":".eos/work-cycles.tsv","operational_schema":".eos/schemas/wc.schema.json","schema":".eos/schemas/wc.schema.json","state_machine":".eos/state-machines/wc.json","parent":"PI"},
