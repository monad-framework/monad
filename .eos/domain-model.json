{
  "schema_version":"2.0.0",
  "model_version":"1.0.0",
  "description":"Canonical EOS Core Schema and Domain Model. Canonical entity schemas are normative; legacy TSV/CLI schemas remain operational projections where present.",
  "base_schema":".eos/schemas/core/base-entity.schema.json",
  "identity":{"immutable_ids":true,"reuse_forbidden":true,"rename_creates_successor":true,"namespaces":{"PROJ":"^PROJ-[A-Z0-9][A-Z0-9-]*$","ART":"^ART-[A-Z0-9][A-Z0-9-]*$","REQ":"^REQ-[A-Z0-9][A-Z0-9-]*$","CAP":"^CAP-[A-Z0-9][A-Z0-9-]*$","ADR":"^ADR-[0-9]{4}$","SPEC":"^SPEC-[A-Z0-9][A-Z0-9-]*$","RISK":"^RISK-[0-9]{3,4}$","PI":"^PI(?:-[A-Z][A-Z0-9]*)?-[0-9]{3}$","WC":"^WC(?:-[A-Z][A-Z0-9]*)?-[0-9]{4}$","WP":"^WP(?:-[A-Z][A-Z0-9]{1,15})?-[0-9]{4}$","REV":"^REV-[A-Z0-9][A-Z0-9-]*$","CR":"^CR-[0-9]{4}$","REL":"^REL-[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$","MNT":"^MNT-[0-9]{4}$","EVID":"^EVID-[0-9]{4,}$","DEC":"^DEC-[A-Z0-9][A-Z0-9-]*$","APR":"^APR-[A-Z0-9][A-Z0-9-]*$","DEP":"^DEP-[A-Z0-9][A-Z0-9-]*$","TRC":"^TRC-[A-Z0-9][A-Z0-9-]*$"}},
  "common_contract":{"required_fields":["id","entity_type","schema_version","version","lifecycle_state","created_at","updated_at","relationships","authority_level","provenance"],"version_semantics":"Entity version is semantic and independent of schema_version. IDs are immutable across versions.","timestamp_semantics":"created_at is immutable; updated_at advances on material mutation; effective_at/closed_at are optional lifecycle timestamps."},
  "authority_levels":{"L0_INFORMATIVE":{"rank":0,"meaning":"Descriptive or derived information; cannot authorize or override governed state."},"L1_ADVISORY":{"rank":1,"meaning":"Recommendation or analysis; informs decisions but is non-binding."},"L2_NORMATIVE":{"rank":2,"meaning":"Approved project rule or contract that implementations must conform to unless superseded or explicitly waived."},"L3_BINDING":{"rank":3,"meaning":"Active authorization, release, approval, or control decision with binding operational effect."},"L4_HUMAN_SOVEREIGN":{"rank":4,"meaning":"Reserved for human authority over mission, material risk acceptance, irreversible actions, and explicit governance overrides."}},
  "provenance":{"required":["origin","created_by","source_refs","generation_method"],"origins":["HUMAN","CHATGPT","CODEX","AUTOMATION","IMPORT","MIGRATION","GITHUB","EXTERNAL"],"integrity_fields":["commit_sha","content_sha256"],"rule":"Derived projections must preserve links to canonical source refs and may not silently elevate their authority."},
  "relationship_types":["CONTAINS","BELONGS_TO","DERIVES_FROM","SUPERSEDES","SUPERSEDED_BY","IMPLEMENTS","SATISFIES","VERIFIED_BY","EVIDENCES","REVIEWS","APPROVES","DEPENDS_ON","BLOCKS","TRACES_TO","REFERENCES","CONFORMS_TO","CONSTRAINED_BY","AFFECTS","INCLUDES","PRODUCES","CONSUMES","RELEASES","MAINTAINS","GOVERNS","AUTHORIZED_BY"],
  "entities":{
