    "DEC":{"name":"Decision","entity_type":"Decision","id_prefix":"DEC","canonical_schema":".eos/schemas/core/decision.schema.json","lifecycle_states":["PROPOSED","DECIDED","SUPERSEDED","REVOKED"],"parent":null},
    "APR":{"name":"Approval","entity_type":"Approval","id_prefix":"APR","canonical_schema":".eos/schemas/core/approval.schema.json","lifecycle_states":["REQUESTED","GRANTED","DENIED","EXPIRED","REVOKED"],"parent":null},
    "DEP":{"name":"Dependency","entity_type":"Dependency","id_prefix":"DEP","canonical_schema":".eos/schemas/core/dependency.schema.json","lifecycle_states":["PROPOSED","ACTIVE","SATISFIED","BLOCKED","WAIVED","RETIRED"],"parent":null},
    "TRC":{"name":"Trace Edge","entity_type":"TraceEdge","id_prefix":"TRC","canonical_schema":".eos/schemas/core/trace-edge.schema.json","lifecycle_states":["ACTIVE","STALE","SUPERSEDED","RETIRED"],"parent":null}
  },
  "canonical_state":{"event_ledger":".eos/events.jsonl","operational_projection":"TSV lifecycle registries for entities currently managed by the EOS CLI","human_projection":"governed Markdown and other canonical Git artifacts","rule":"Canonical entity identity and semantics are defined by this domain model and core schemas. Lifecycle mutations for operational entities remain append-only-event-driven and atomically projected."},
  "compatibility":{"legacy_operational_schemas_preserved":true,"reason":"The current EOS CLI uses a deliberately small schema validator for TSV registry rows. Canonical v2 schemas are additive and do not break existing lifecycle operations."}
}
