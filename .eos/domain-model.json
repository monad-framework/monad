    "RISK":{"name":"Risk","entity_type":"Risk","id_prefix":"RISK","canonical_schema":".eos/schemas/core/risk.schema.json","lifecycle_states":["IDENTIFIED","ANALYZED","MITIGATING","ACCEPTED","CLOSED","MATERIALIZED"],"parent":null},
