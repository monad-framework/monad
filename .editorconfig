# EditorConfig keeps basic whitespace behavior consistent across editors.
# See https://editorconfig.org/ for supported client integrations.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
max_line_length = 100
trim_trailing_whitespace = false

[*.{py,rs,go,java}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.bat]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,webp,ico,pdf}]
insert_final_newline = unset
trim_trailing_whitespace = unset
